{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project ARENA",
  "version": "0.1.2",
  "identifier": "io.project-arena.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1431",
    "beforeBuildCommand": "npm run licenses && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Project ARENA — Algorithm Arena",
        "width": 1440,
        "height": 1000,
        "minWidth": 800,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "../LICENSE",
      "../THIRD_PARTY_NOTICES.md",
      "../build-notices/THIRD-PARTY-LICENSES.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
